rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 최고 관리자(마스터). js/config.js 의 MASTER_EMAIL 과 반드시 같아야 한다.
    function isMaster() {
      return request.auth != null
        && request.auth.token.email == "snowdrop.brandon@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // 관리자: 최고 관리자 또는 config/admins 문서의 emails 목록에 있는 계정
    function isAdmin() {
      return isMaster() || (
        request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.emails
      );
    }

    // 클라우드 세이브: 로그인한 사용자는 자기 uid 아래만 읽고 쓸 수 있다.
    //  - saves/{uid}               : 슬롯 도입 전 단일 세이브 (읽기·삭제만. 게임이 자동 저장 슬롯으로 옮긴다)
    //  - saves/{uid}/slots/{slot}  : 자동 저장 1개(auto) + 수동 저장 5개(1~5)
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version', 'savedAt', 'player', 'inventory', 'party']);

      match /slots/{slot} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && slot in ['auto', '1', '2', '3', '4', '5']
          && request.resource.data.keys().hasOnly(['version', 'savedAt', 'player', 'inventory', 'party']);
      }
    }

    // 시나리오 복호화 키: 게임이 스크립트를 풀어야 하므로 읽기는 누구나.
    // 생성·삭제는 관리자만. 키는 바꾸지 않고 새로 만들어 교체한다(수정 금지).
    match /scriptKeys/{keyId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['key', 'createdAt', 'by']);
      allow delete: if isAdmin();
      allow update: if false;
    }

    // 관리자 전용 (GitHub 토큰 등). 관리자 페이지는 이 문서 읽기로 서버 측 권한을 확인한다.
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // 관리자 목록: 관리자는 읽기, 최고 관리자만 쓰기
    match /config/admins {
      allow read: if isAdmin();
      allow write: if isMaster() && request.resource.data.keys().hasOnly(['emails', 'updatedAt'])
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 50;
    }

    // 그 밖의 경로는 모두 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
